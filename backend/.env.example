# SIH26139 backend — environment configuration
#
# Copy to `backend/.env` for local overrides. Every variable below already has
# a working default baked into app/config.py (and app/db/database.py for
# DATABASE_URL), so `uvicorn app.main:app` boots with ZERO env vars set — you
# only need this file at all once you want something other than the local
# SQLite / stub-model / open-CORS defaults.
#
# Never commit a real .env — this file (.env.example) is the only one that
# belongs in git, and only with placeholder values.

# Local dev default (no env var set): sqlite:///./dev.db
DATABASE_URL=postgresql://<user>:<password>@<your-project>.neon.tech/<db>?sslmode=require

MODEL_PATH=./models/model_weights.pt
MODEL_VERSION=stub-v0
RISK_THRESHOLD_MEDIUM=0.4
RISK_THRESHOLD_HIGH=0.7

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://<your-frontend>.vercel.app

SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_RATE_LIMIT=25/minute

PORT=8000
