# Copy to backend/.env and adjust for your environment.
# Every var below has a working default in app/config.py if omitted -
# this file exists so docker-compose.yml has something to load, and so
# the real Postgres/production values are documented in one place.

# SQLite by default; use a Neon/Postgres connection string in production.
DATABASE_URL=sqlite:///./local_dev.db

MODEL_PATH=./models/model_weights.pt
MODEL_VERSION=stub-v0

RISK_THRESHOLD_MEDIUM=0.4
RISK_THRESHOLD_HIGH=0.7

# Comma-separated list the frontend origin must be in. Matches the
# frontend's Vite dev server (5173) - the compose file's own frontend
# service also publishes on 5173.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Dev-only. Generate a real value before any non-local deploy:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-before-any-real-deploy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_RATE_LIMIT=25/minute
